    {
      "id": 11,
      "type": "stat",
      "title": "Active alerts",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
