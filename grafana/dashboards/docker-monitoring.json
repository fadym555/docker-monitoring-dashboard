    },
    {
      "id": 4,
      "type": "stat",
      "title": "Stopped",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "engine_daemon_container_states_containers{state=\"stopped\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Green: none stopped. Orange: 1-2. Red: 3 or more.",
      "fieldConfig": {
        "defaults": {
