# Public hostname for the dashboard. Caddy gets a Let's Encrypt certificate for it.
# No domain? Use your server's public IP with dashes plus .sslip.io, e.g. 3-120-45-67.sslip.io
# (scripts/install-ubuntu.sh sets this for you).
DOMAIN=localhost

# Grafana admin account. Only reachable through an SSH tunnel to 127.0.0.1:3000.
# Applied on the first start; change it later in Grafana itself.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# How long Prometheus keeps history.
PROMETHEUS_RETENTION=15d

# "demo" also starts sample containers so the dashboard has data to show.
# Leave it empty to run only the monitoring stack.
COMPOSE_PROFILES=demo
