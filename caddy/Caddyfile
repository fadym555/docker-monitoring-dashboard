# Public HTTPS entry point.
# With a real DOMAIN, Caddy gets a Let's Encrypt certificate automatically.
# With DOMAIN=localhost it uses its own local certificate (for testing).
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Visitors get read-only dashboards. Admin pages and login are only
	# reachable through the SSH tunnel to 127.0.0.1:3000.
	@admin path /login* /admin* /api/admin* /api/users* /api/org* /api/serviceaccounts* /api/auth/keys*
	respond @admin "Not found" 404

	reverse_proxy grafana:3000
}
